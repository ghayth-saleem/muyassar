{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_audit_log.py\"",
            "timeout": 10,
            "statusMessage": "Checking audit log protection"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate_kb_metadata.py\"",
            "timeout": 30,
            "statusMessage": "Validating knowledge-base metadata"
          }
        ]
      }
    ]
  }
}

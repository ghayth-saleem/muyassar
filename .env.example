# انسخ هاد الملف باسم .env وحط مفتاحك. ملف .env مستثنى من git.
ANTHROPIC_API_KEY=

# anthropic (الافتراضي) أو gemini أو ollama للنموذج المحلي
MUYASSAR_LLM=anthropic

# gemini: مفتاح Google AI Studio (التبديل: MUYASSAR_LLM=gemini)، وبدها pip install google-genai
GEMINI_API_KEY=
